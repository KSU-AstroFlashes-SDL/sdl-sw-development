{
  "name": "SDL Development",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "remoteUser": "developer",
  "mounts": [
    "source=sdl-sw-developer-home,target=/home/developer,type=volume"
  ],
  "runArgs": [
    "--userns=keep-id"
  ],
  "workspaceFolder": "/home/developer",
  "customizations": {
    "vscode": {
      "settings": {
        "dev.containers.mountWaylandSocket": false
      }
    }
  },
  "postCreateCommand": "bash /opt/lifecycle/postCreate.sh",
  "postAttachCommand": "bash /opt/lifecycle/postAttach.sh"
}
